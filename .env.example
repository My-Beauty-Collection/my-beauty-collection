# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase.
# Senza questi valori l'app salva i dati solo nel browser (modalità locale).

# Project URL — Project Settings → Data API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Anon / publishable key — Project Settings → API Keys
VITE_SUPABASE_ANON_KEY=
# Secret / service_role key — solo per script locali, MAI con prefisso VITE_
SUPABASE_SECRET_KEY=
# (Facoltativo) Connection string del database — pulsante "Connect" → Session pooler
SUPABASE_DB_URL=
